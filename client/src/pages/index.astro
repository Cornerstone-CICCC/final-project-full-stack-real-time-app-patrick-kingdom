---
// ✅ AUTH (Pam): guard + get username from session
import Layout from "../layouts/Layout.astro";

const SERVER_URL = import.meta.env.PUBLIC_SERVER_URL ?? "http://localhost:3000";

const meRes = await fetch(`${SERVER_URL}/api/auth/me`, {
  headers: { cookie: Astro.request.headers.get("cookie") ?? "" },
});

if (!meRes.ok) {
  return Astro.redirect("/login");
}

const { username } = await meRes.json();
// ✅ END AUTH
---

<Layout title="Chat">
  <main class="mx-auto flex h-screen max-w-4xl flex-col p-4">

    <!-- ✅ AUTH (Pam): top bar with logged-in user + logout -->
    <header class="flex items-center justify-between border-b border-black pb-3 mb-4">
      <span class="text-sm text-gray-500">
        Signed in as <strong class="text-black">{username}</strong>
      </span>
      <button
        id="logout-btn"
        class="border border-black px-3 py-1 text-sm hover:bg-black hover:text-white"
      >
        Sign out
      </button>
    </header>
    <!-- ✅ END AUTH -->

    <!-- Join screen -->
    <section id="join-screen" class="m-auto w-full max-w-sm">
      <h1 class="mb-6 text-2xl font-bold">Real-Time Chat</h1>
      <form id="join-form" class="flex flex-col gap-3">
        <!-- ✅ AUTH (Pam): username input removed — provided by session via window.__USERNAME__ -->
        <label for="room-name" class="text-sm">Room name</label>
        <input
          id="room-name"
          name="room"
          type="text"
          required
          maxlength="30"
          autocomplete="off"
          value="General"
          placeholder="Enter or create a room"
          class="border border-black px-3 py-2 focus:outline-2 focus:outline-black"
        />
        <div>
          <p class="mb-2 text-sm">Available rooms</p>
          <ul id="room-list" class="flex flex-wrap gap-2 text-sm"></ul>
        </div>
        <button
          type="submit"
          class="border border-black bg-black px-3 py-2 text-white hover:bg-white hover:text-black"
        >
          Join or Create Room
        </button>
      </form>
    </section>

    <!-- Chat screen -->
    <section id="chat-screen" class="min-h-0 flex-1" hidden>
      <div class="flex h-full min-h-0 flex-col gap-4 md:flex-row">
        <section class="flex min-h-0 flex-1 flex-col">
          <header class="border-b border-black pb-2">
            <h1 id="current-room" class="text-xl font-bold">General Room</h1>
            <p id="current-user" class="text-sm"></p>
          </header>

          <ul id="message-list" class="flex-1 space-y-2 overflow-y-auto py-4"></ul>

          <form id="message-form" class="flex gap-2 border-t border-black pt-4">
            <input
              id="message-input"
              name="message"
              type="text"
              required
              maxlength="500"
              autocomplete="off"
              placeholder="Type a message"
              class="flex-1 border border-black px-3 py-2 focus:outline-2 focus:outline-black"
            />
            <button
              type="submit"
              class="border border-black bg-black px-4 py-2 text-white hover:bg-white hover:text-black"
            >
              Send
            </button>
          </form>
        </section>

        <aside class="border border-black p-3 md:w-56">
          <h2 class="mb-3 font-bold">Online Users</h2>
          <ul id="online-user-list" class="space-y-2 text-sm"></ul>
        </aside>
      </div>
    </section>
  </main>
</Layout>

<!-- ✅ AUTH (Pam): exposes session username to chat.ts -->
<script define:vars={{ username }}>
  window.__USERNAME__ = username;
</script>
<!-- ✅ END AUTH -->

<script>
  // ✅ AUTH (Pam): logout handler
  const SERVER_URL = import.meta.env.PUBLIC_SERVER_URL ?? "http://localhost:3000";
  document.getElementById("logout-btn")?.addEventListener("click", async () => {
    await fetch(`${SERVER_URL}/api/auth/logout`, {
      method: "POST",
      credentials: "include",
    });
    window.location.href = "/login";
  });
</script>

<script>
  import "../scripts/chat";
</script>
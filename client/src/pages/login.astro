---
import Layout from "../layouts/Layout.astro";

const SERVER_URL = import.meta.env.PUBLIC_SERVER_URL ?? "http://localhost:3000";

// If already logged in, redirect to chat
const meRes = await fetch(`${SERVER_URL}/api/auth/me`, {
  headers: { cookie: Astro.request.headers.get("cookie") ?? "" },
});
if (meRes.ok) {
  return Astro.redirect("/chat");
}
---

<Layout title="Login — RealChat">
  <main class="mx-auto flex min-h-screen max-w-sm flex-col items-center justify-center p-6">
    <div class="w-full border border-black p-8">
      <h1 class="mb-2 text-2xl font-bold">Welcome back</h1>
      <p class="mb-6 text-sm text-gray-500">Sign in to continue to RealChat</p>

      <!-- Error message (hidden by default) -->
      <p id="error-msg" class="mb-4 hidden border border-red-400 bg-red-50 px-3 py-2 text-sm text-red-700"></p>

      <form id="login-form" class="flex flex-col gap-4" novalidate>
        <div class="flex flex-col gap-1">
          <label for="username" class="text-sm font-medium">Username</label>
          <input
            id="username"
            name="username"
            type="text"
            required
            maxlength="20"
            autocomplete="username"
            placeholder="Enter your username"
            class="border border-black px-3 py-2 focus:outline-2 focus:outline-black"
          />
        </div>

        <div class="flex flex-col gap-1">
          <label for="password" class="text-sm font-medium">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            placeholder="Enter your password"
            class="border border-black px-3 py-2 focus:outline-2 focus:outline-black"
          />
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="border border-black bg-black px-3 py-2 text-white hover:bg-white hover:text-black disabled:opacity-50"
        >
          Sign in
        </button>
      </form>

      <p class="mt-6 text-center text-sm text-gray-500">
        Don't have an account?
        <a href="/register" class="font-medium text-black underline hover:no-underline">Register</a>
      </p>
    </div>
  </main>
</Layout>

<script>
  const SERVER_URL = import.meta.env.PUBLIC_SERVER_URL ?? "http://localhost:3000";

  const form = document.getElementById("login-form") as HTMLFormElement;
  const errorMsg = document.getElementById("error-msg") as HTMLParagraphElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

  function showError(message: string) {
    errorMsg.textContent = message;
    errorMsg.classList.remove("hidden");
  }

  function clearError() {
    errorMsg.textContent = "";
    errorMsg.classList.add("hidden");
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearError();

    const username = (document.getElementById("username") as HTMLInputElement).value.trim();
    const password = (document.getElementById("password") as HTMLInputElement).value.trim();

    if (!username || !password) {
      showError("Please fill in all fields.");
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "Signing in...";

    try {
      const res = await fetch(`${SERVER_URL}/api/auth/login`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ username, password }),
      });

      const data = await res.json();

      if (!res.ok) {
        showError(data.error ?? "Login failed. Please try again.");
        return;
      }

      window.location.href = "/chat";
    } catch {
      showError("Could not connect to the server. Please try again.");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Sign in";
    }
  });
</script>
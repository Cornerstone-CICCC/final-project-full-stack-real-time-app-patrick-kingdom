---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Register — RealChat">
  <main class="mx-auto flex min-h-screen max-w-sm flex-col items-center justify-center p-6">
    <div class="w-full border border-black p-8">
      <h1 class="mb-2 text-2xl font-bold">Create account</h1>
      <p class="mb-6 text-sm text-black">Join RealChat to start messaging</p>

      <!-- Error message (hidden by default) -->
      <p id="error-msg" class="mb-4 hidden border border-black bg-white px-3 py-2 text-sm text-black"></p>

      <form id="register-form" class="flex flex-col gap-4" novalidate>
        <div class="flex flex-col gap-1">
          <label for="username" class="text-sm font-medium">Username</label>
          <input
            id="username"
            name="username"
            type="text"
            required
            maxlength="20"
            autocomplete="username"
            placeholder="Choose a username (max 20 chars)"
            class="border border-black px-3 py-2 focus:outline-2 focus:outline-black"
          />
        </div>

        <div class="flex flex-col gap-1">
          <label for="password" class="text-sm font-medium">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="new-password"
            placeholder="At least 6 characters"
            class="border border-black px-3 py-2 focus:outline-2 focus:outline-black"
          />
        </div>

        <div class="flex flex-col gap-1">
          <label for="confirm-password" class="text-sm font-medium">Confirm password</label>
          <input
            id="confirm-password"
            name="confirmPassword"
            type="password"
            required
            autocomplete="new-password"
            placeholder="Repeat your password"
            class="border border-black px-3 py-2 focus:outline-2 focus:outline-black"
          />
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="border border-black bg-black px-3 py-2 text-white hover:bg-white hover:text-black disabled:opacity-50"
        >
          Create account
        </button>
      </form>

      <p class="mt-6 text-center text-sm text-black">
        Already have an account?
        <a href="/login" class="font-medium text-black underline hover:no-underline">Sign in</a>
      </p>
    </div>
  </main>
</Layout>

<script>
  const SERVER_URL = import.meta.env.PUBLIC_SERVER_URL ?? "http://localhost:3000";

  const form = document.getElementById("register-form") as HTMLFormElement;
  const errorMsg = document.getElementById("error-msg") as HTMLParagraphElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

  fetch(`${SERVER_URL}/api/auth/me`, {
    credentials: "include",
  })
    .then((res) => {
      if (res.ok) window.location.href = "/";
    })
    .catch(() => {});

  function showError(message: string) {
    errorMsg.textContent = message;
    errorMsg.classList.remove("hidden");
  }

  function clearError() {
    errorMsg.textContent = "";
    errorMsg.classList.add("hidden");
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearError();

    const username = (document.getElementById("username") as HTMLInputElement).value.trim();
    const password = (document.getElementById("password") as HTMLInputElement).value.trim();
    const confirmPassword = (document.getElementById("confirm-password") as HTMLInputElement).value.trim();

    // Client-side validation
    if (!username || !password || !confirmPassword) {
      showError("Please fill in all fields.");
      return;
    }
    if (password !== confirmPassword) {
      showError("Passwords do not match.");
      return;
    }
    if (password.length < 6) {
      showError("Password must be at least 6 characters.");
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "Creating account...";

    try {
      const res = await fetch(`${SERVER_URL}/api/auth/register`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ username, password }),
      });

      const data = await res.json();

      if (!res.ok) {
        showError(data.error ?? "Registration failed. Please try again.");
        return;
      }

      window.location.href = "/";
    } catch {
      showError("Could not connect to the server. Please try again.");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Create account";
    }
  });
</script>

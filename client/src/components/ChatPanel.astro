---
type Variant = "preview" | "full";

interface Props {
  variant?: Variant;
}

const { variant = "full" } = Astro.props;
const isPreview = variant === "preview";
---

{
  isPreview ? (
    <section id="chat-screen" class="flex h-full min-h-0 flex-col">
      <div class="grid h-full min-h-0 grid-cols-[minmax(0,1fr)_220px] gap-3 p-4">
        <section class="flex min-h-0 flex-col rounded border border-black bg-white text-black">
          <header class="border-b border-black px-4 py-3">
            <h1 id="current-room" class="text-lg font-bold">General Room</h1>
            <p id="current-user" class="text-sm"></p>
          </header>
          <ul id="message-list" class="min-h-0 flex-1 space-y-2 overflow-y-auto px-4 py-3 text-sm"></ul>
          <form id="message-form" class="flex gap-2 border-t border-black p-3">
            <input
              id="message-input"
              name="message"
              type="text"
              required
              maxlength="500"
              autocomplete="off"
              placeholder="Type a message"
              class="min-w-0 flex-1 rounded border border-black bg-white px-3 py-2 text-black focus:outline-2 focus:outline-black"
            />
            <button
              type="submit"
              class="rounded border border-black bg-black px-4 py-2 text-white hover:bg-white hover:text-black"
            >
              Send
            </button>
          </form>
        </section>
        <aside class="flex min-h-0 flex-col rounded border border-black bg-white p-3 text-black">
          <h2 class="rounded-full border border-black bg-black py-1 text-center font-bold text-white">Chat</h2>
          <ul id="online-user-list" class="mt-3 min-h-0 flex-1 space-y-2 overflow-y-auto text-sm"></ul>
          <a
            href="/chat"
            class="mt-3 rounded-full border border-black bg-black py-2 text-center font-bold text-white hover:bg-white hover:text-black"
          >
            Open Chat
          </a>
        </aside>
      </div>
    </section>
  ) : (
    <section id="chat-screen" class="mx-auto flex min-h-0 w-full max-w-6xl flex-1 flex-col">
      <header class="relative flex h-14 shrink-0 items-center border-b border-black bg-white">
        <button
          id="visitors-back"
          type="button"
          class="absolute left-0 top-0 hidden size-14 place-items-center border-r border-black text-3xl font-bold hover:bg-gray-100 lg:hidden"
          aria-label="Back to chat"
        >
          <span aria-hidden="true">&lt;</span>
        </button>
        <h1 id="current-room" class="min-w-0 flex-1 truncate px-16 text-center text-xl font-bold lg:px-4 lg:text-left">
          General Room
        </h1>
        <button
          id="visitors-toggle"
          type="button"
          class="absolute right-0 top-0 grid size-14 place-items-center border-l border-black text-2xl font-bold hover:bg-gray-100 lg:hidden"
          aria-label="Show current users"
          aria-pressed="false"
        >
          <span class="relative block h-7 w-8" aria-hidden="true">
            <span class="absolute left-1 top-1 block size-3 rounded-full bg-black"></span>
            <span class="absolute right-1 top-1 block size-3 rounded-full bg-black"></span>
            <span class="absolute bottom-1 left-0 block h-3 w-4 rounded-t-full border-2 border-black"></span>
            <span class="absolute bottom-1 right-0 block h-3 w-4 rounded-t-full border-2 border-black"></span>
          </span>
        </button>
      </header>

      <p id="current-user" class="sr-only"></p>

      <div class="grid min-h-0 flex-1 lg:grid-cols-[minmax(0,1fr)_260px]">
        <section id="mobile-chat-panel" class="flex min-h-0 flex-col bg-white">
          <ul id="message-list" class="min-h-0 flex-1 space-y-3 overflow-y-auto px-4 py-4"></ul>
          <form id="message-form" class="grid h-20 shrink-0 grid-cols-[minmax(0,1fr)_80px] border-t border-black bg-gray-100">
            <input
              id="message-input"
              name="message"
              type="text"
              required
              maxlength="500"
              autocomplete="off"
              placeholder="Type a message"
              class="min-w-0 border-0 border-r border-black bg-gray-100 px-4 text-lg text-black focus:outline-2 focus:outline-black"
            />
            <button type="submit" class="bg-gray-100 px-3 text-lg font-bold text-black hover:bg-black hover:text-white">
              Send
            </button>
          </form>
        </section>

        <aside id="visitors-panel" class="hidden min-h-0 overflow-y-auto bg-white lg:block lg:border-l lg:border-black">
          <h2 class="hidden border-b border-black bg-gray-200 py-3 text-center text-lg font-bold lg:block">Chat</h2>
          <ul id="online-user-list" class="space-y-2 p-4 text-sm"></ul>
        </aside>
      </div>
    </section>
  )
}
